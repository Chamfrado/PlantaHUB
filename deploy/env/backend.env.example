# /opt/plantahub/backend/.env — variáveis de RUNTIME do backend (lido pelo systemd).
#
# Dono root:plantahub, permissão 640. NUNCA versione o arquivo preenchido.
#
# Formato do EnvironmentFile do systemd:
#   - VAR=valor, sem "export", sem espaços em volta do "=";
#   - NÃO use comentário no fim da linha: "VAR=x # obs" faz o valor virar "x # obs";
#   - aspas são opcionais; use-as se o valor tiver espaços.
#
# Levantado a partir de application.yml, application-prod.yml e dos @Value do código.
# Legenda: [OBRIGATÓRIA|OPCIONAL] [SECRET|não-secret] — todas são backend/runtime.

# ---------------------------------------------------------------- perfil
# [OBRIGATÓRIA][não-secret] Também fixada no unit do systemd. Sem "prod" o backend sobe
# em modo DEV: expõe DevOrderController (marcar pedido como pago) e cria conta de admin
# de desenvolvimento. Não remova.
SPRING_PROFILES_ACTIVE=prod

# [OPCIONAL][não-secret] Também fixada no unit. Faz o Spring escutar só em loopback;
# o acesso externo passa pelo Nginx.
SERVER_ADDRESS=127.0.0.1

# ---------------------------------------------------------------- banco
# [OBRIGATÓRIA][não-secret] Sem default no perfil prod.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/plantahub
# [OBRIGATÓRIA][não-secret]
SPRING_DATASOURCE_USERNAME=plantahub
# [OBRIGATÓRIA][SECRET] A mesma usada em 02-setup-postgresql.sh.
SPRING_DATASOURCE_PASSWORD=TROQUE_PELA_SENHA_DO_BANCO

# ---------------------------------------------------------------- JWT / cookies
# [OBRIGATÓRIA][SECRET] Mínimo 32 bytes (HMAC-SHA; menor que isso o boot falha com
# WeakKeyException). Gere com: openssl rand -base64 64 | tr -d '\n'
# ATENÇÃO: se você restaurar o banco da VM antiga, reutilize o JWT_SECRET antigo OU
# defina APP_SECRETS_KEY com o valor antigo — ver APP_SECRETS_KEY abaixo.
JWT_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES
# [OPCIONAL][não-secret] Default true no perfil prod. Mantenha true (cookie só via HTTPS).
AUTH_COOKIE_SECURE=true

# [OPCIONAL][SECRET] Chave que cifra (AES-GCM) as credenciais AWS gravadas pelo painel
# (tabela app_secret, V30). Não aparece em nenhum .yml: é lida por @Value("${app.secrets.key:}")
# em SecretCipher. Vazia => derivada do JWT_SECRET. Consequência: trocar o JWT_SECRET
# torna ilegíveis as credenciais salvas no painel (é preciso salvá-las de novo).
APP_SECRETS_KEY=

# ---------------------------------------------------------------- web / CORS
# [OPCIONAL][não-secret] Default do perfil prod: as duas origens abaixo. Lista separada
# por vírgula, sem espaço.
APP_CORS_ALLOWED_ORIGINS=https://plantahub.com.br,https://www.plantahub.com.br
# [OPCIONAL][não-secret] Declarada nos .yml, mas hoje não é lida por nenhuma classe.
APP_WEB_BASE_URL=https://www.plantahub.com.br

# ---------------------------------------------------------------- admin
# [OPCIONAL][não-secret] E-mails promovidos a ADMIN no boot (vírgula). Só promove quem
# já tem conta: cadastre-se no site primeiro e reinicie o serviço.
APP_ADMIN_BOOTSTRAP_EMAILS=

# ---------------------------------------------------------------- AWS S3
# [OBRIGATÓRIA][não-secret] Sem default no perfil prod. As URLs já gravadas no banco
# (V17, V25, V28) e a capa fixa em Home.tsx usam plantahub-assets em us-east-2.
APP_S3_BUCKET=plantahub-assets
# [OBRIGATÓRIA][não-secret]
APP_S3_REGION=us-east-2
# [OPCIONAL][SECRET] Vazias => credenciais do painel (tabela app_secret) ou a cadeia
# padrão da AWS (variáveis AWS_*, ~/.aws, instance role). Ordem: painel > estas > cadeia.
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
# [OPCIONAL][não-secret] Base pública das imagens de vitrine (ex.: CloudFront). Vazia =>
# https://<bucket>.s3.<região>.amazonaws.com
APP_S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- uploads / downloads
# [OPCIONAL][não-secret] Default 2147483648 (2 GiB).
APP_UPLOADS_MAX_SIZE_BYTES=2147483648
# [OPCIONAL][não-secret] Default true.
APP_UPLOADS_JANITOR_ENABLED=true
# [OPCIONAL][não-secret] Default true. Só desligue após o backfill (docs/production.md).
APP_DOWNLOADS_LEGACY_FALLBACK=true

# ---------------------------------------------------------------- pedidos
# [OPCIONAL][não-secret] Defaults 48 e 3600000. Só em application.yml (o prod herda).
ORDERS_PENDING_EXPIRATION_HOURS=48
ORDERS_PENDING_EXPIRATION_SCAN_MS=3600000

# ---------------------------------------------------------------- InfinitePay
# [OBRIGATÓRIA][não-secret] Sem default no perfil prod. Handle da conta InfinitePay.
INFINITEPAY_HANDLE=TROQUE_PELO_HANDLE
# [OBRIGATÓRIA][não-secret]
INFINITEPAY_REDIRECT_URL=https://www.plantahub.com.br/pagamento/sucesso
# [OBRIGATÓRIA][não-secret]
INFINITEPAY_WEBHOOK_URL=https://api.plantahub.com.br/v1/webhooks/infinitepay
# [OPCIONAL][não-secret]
INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io

# ---------------------------------------------------------------- recuperação de senha
# [OBRIGATÓRIA][SECRET] Chave do HMAC que protege, no banco, os códigos e tokens de
# recuperação de senha. Mínimo 32 caracteres. Sem default no perfil prod.
# Gere com: openssl rand -base64 48 | tr -d '\n'
APP_PASSWORD_RESET_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO

# ---------------------------------------------------------------- e-mail (SMTP)
# [OPCIONAL][não-secret] Default true no perfil prod. Com false os e-mails são
# descartados (ninguém recupera a senha por e-mail). Com true, SPRING_MAIL_HOST é exigido.
APP_MAIL_ENABLED=true
# [OPCIONAL][não-secret] Remetente. O domínio precisa de SPF/DKIM para não cair no spam.
APP_MAIL_FROM=PlantaHub <nao-responda@plantahub.com.br>
# [OBRIGATÓRIA com e-mail ligado][não-secret]
SPRING_MAIL_HOST=TROQUE_PELO_HOST_SMTP
# [OPCIONAL][não-secret] Default 587 (STARTTLS).
SPRING_MAIL_PORT=587
# [OPCIONAL][não-secret]
SPRING_MAIL_USERNAME=
# [OPCIONAL][SECRET]
SPRING_MAIL_PASSWORD=

# ---------------------------------------------------------------- SMS (Twilio)
# [OPCIONAL][não-secret] Default false: a tela de recuperação só oferece e-mail.
APP_SMS_ENABLED=false
# [OBRIGATÓRIA com SMS ligado][não-secret] Começa com AC.
TWILIO_ACCOUNT_SID=
# [OBRIGATÓRIA com SMS ligado][SECRET]
TWILIO_AUTH_TOKEN=
# [uma das duas com SMS ligado][não-secret] Número remetente em E.164 (+1...) ou o SID
# de um Messaging Service (começa com MG). Se as duas vierem, o Messaging Service ganha.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------- JVM
# [OPCIONAL] Sobrescreve o JAVA_OPTS do unit do systemd. Exemplo para VM de 2 GB:
# JAVA_OPTS=-XX:MaxRAMPercentage=45 -XX:+ExitOnOutOfMemoryError
